# Environment variables for intellifunnel-console.
# Copy to .env for local development against docker-compose Postgres
# (`docker compose up -d postgres`), or to .env.local for Neon.
#
# DATABASE_URL is the pooled connection used by the app at runtime.
# DIRECT_URL is the unpooled connection used by Prisma Migrate.
# Both point at the same local database in docker-compose; against Neon
# they differ (pooled vs. direct host).
DATABASE_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5432/console"
DIRECT_URL="postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5432/console"

# Better Auth (Task 10) — session handling, credential storage, password
# reset and email verification (AUTH-7). Both of these are required:
# src/lib/env.ts refuses to start without them rather than inventing a value.
APP_BASE_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-me"

# Email. An absent or empty EMAIL_PROVIDER_API_KEY means emails are logged
# instead of sent, which is the intended local development mode — leaving the
# two provider values empty below is correct for local work.
EMAIL_FROM="no-reply@example.com"
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_API_KEY=""

# Suppression lists (Task 19) — salt for hashing suppression entry values.
# Required, with no fallback: hashes written under a substituted salt can
# never be matched against hashes written under the real one.
SUPPRESSION_HASH_SALT="replace-me"
